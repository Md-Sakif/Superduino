From b2f3152a01501eff10d8e98d0cc86c5ccdee0acf Mon Sep 17 00:00:00 2001
From: sakifu <pritom.mojumder.kuet@gmail.com>
Date: Sat, 26 Sep 2026 22:09:16 +0600
Subject: [PATCH 3/4] fix(autoreload): use absolute paths to check file times

For files inside the project `doc.filename` is relative to the project,
but the working directory is not changed to the project, so
`system.get_file_info(doc.filename)` found nothing (or another file) and
changed files were never reloaded unless the editor was started from
inside the project folder. Use `doc.abs_filename` instead.
---
 data/plugins/autoreload.lua | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/data/plugins/autoreload.lua b/data/plugins/autoreload.lua
index 57356eee..b8260ac4 100644
--- a/data/plugins/autoreload.lua
+++ b/data/plugins/autoreload.lua
@@ -26,7 +26,7 @@ local times = setmetatable({}, { __mode = "k" })
 local visible = setmetatable({}, { __mode = "k" })
 
 local function update_time(doc)
-  local info = system.get_file_info(doc.filename)
+  local info = system.get_file_info(doc.abs_filename)
   times[doc] = info and info.modified
 end
 
@@ -103,7 +103,7 @@ core.add_thread(function()
     watch:check(function(file)
       for i, doc in ipairs(core.docs) do
         if doc.abs_filename == file then
-          local info = system.get_file_info(doc.filename or "")
+          local info = system.get_file_info(doc.abs_filename or "")
           if info and times[doc] ~= info.modified then
             if not doc:is_dirty() and not config.plugins.autoreload.always_show_nagview then
               reload_doc(doc)
