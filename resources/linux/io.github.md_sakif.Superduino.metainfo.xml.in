<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>io.github.md_sakif.Superduino</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Superduino</name>
  <summary>A lightweight code editor for Arduino and embedded development</summary>
  <content_rating type="oars-1.0" />
  <launchable type="desktop-id">io.github.md_sakif.Superduino.desktop</launchable>

  <description>
    <p>
      Superduino is a lightweight code editor for Arduino and embedded
      development, based on the Lite XL editor.
    </p>
  </description>


  <url type="homepage">https://github.com/Md-Sakif/Superduino</url>

  <provides>
    <binary>superduino</binary>
  </provides>

  @METAINFO_RELEASES@
</component>
